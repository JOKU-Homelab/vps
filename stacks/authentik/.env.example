# Add these values to the Infisical project/environment configured for this host.
# This file is an inventory of required secret names, not a live env file.
PG_DB=authentik
PG_USER=authentik
PG_PASS=<generate-a-unique-random-password>
AUTHENTIK_SECRET_KEY=<generate-a-unique-random-secret>
AUTHENTIK_URL=https://authentik.example.com
AUTHENTIK_DOMAIN=authentik.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=<smtp-account>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM_ADDRESS=noreply@example.com
