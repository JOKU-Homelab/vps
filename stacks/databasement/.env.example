# Add Databasement values to /databasement and shared mail values to /smtp in Infisical.
# This file is an inventory of required secret names, not a live env file.
APP_KEY=<generate-random-32-byte-base64-key>
DATABASEMENT_URL=https://databasement.example.com
DATABASEMENT_DOMAIN=databasement.example.com
OAUTH_OIDC_ENABLED=true
OAUTH_OIDC_CLIENT_ID=<authentik-client-id>
OAUTH_OIDC_CLIENT_SECRET=<authentik-client-secret>
OAUTH_OIDC_BASE_URL=https://authentik.example.com/application/o/databasement/
OAUTH_OIDC_LABEL=Authentik
OAUTH_AUTO_CREATE_USERS=false
OAUTH_AUTO_LINK_BY_EMAIL=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=<smtp-account>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_PORT=465
TZ=UTC
DATABASE_BACKUP_DIR=/opt/vps/data/database-backups
