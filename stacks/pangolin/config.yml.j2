gerbil:
  start_port: 51820
  base_endpoint: "pangolin.{{ vps_base_domain }}"

app:
  dashboard_url: "https://pangolin.{{ vps_base_domain }}"
  log_level: info
  telemetry:
    anonymous_usage: false

domains:
  primary:
    base_domain: "{{ vps_base_domain }}"
    cert_resolver: letsencrypt

server:
  cors:
    origins:
      - "https://pangolin.{{ vps_base_domain }}"
      - "https://infisical.{{ vps_base_domain }}"
    methods: [GET, POST, PUT, DELETE, PATCH]
    allowed_headers: [X-CSRF-Token, Content-Type]
    credentials: false
  trust_proxy: 1

{% if vps_smtp_enabled %}
email:
  smtp_host: "{{ vps_smtp_host }}"
  smtp_port: {{ vps_smtp_port }}
  smtp_secure: {{ vps_smtp_secure | lower }}
  no_reply: "{{ vps_smtp_from_address }}"
{% endif %}

flags:
  require_email_verification: false
  disable_signup_without_invite: true
  disable_user_create_org: false
  allow_raw_resources: true
