# Ansible installs this file as /etc/vps-bootstrap/infisical.env (root:root,
# mode 0600). Generate every secret locally; never commit the real file.
# The same values must be added to the Infisical project for ComposeFlux
# reconciliation after first-run setup.

INFISICAL_PUBLIC_DOMAIN=secrets.example.invalid
SITE_URL=https://secrets.example.invalid
INFISICAL_BOOTSTRAP_PORT=18080

# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=REPLACE_WITH_32_HEX_CHARACTERS
# Generate with: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_RANDOM_BASE64_VALUE

POSTGRES_USER=infisical
POSTGRES_DB=infisical
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_VALUE
DB_CONNECTION_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Generate with: openssl rand -hex 32
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX_VALUE
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Optional SMTP values. The installer writes these to this file and Pangolin's
# bootstrap env file when SMTP is enabled.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_ADDRESS=noreply@example.invalid
SMTP_FROM_NAME=Infisical
SMTP_SECURE=false
