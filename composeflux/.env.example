# Copy to /etc/vps-bootstrap/composeflux.env with owner root:root, mode 0600.
# Replace all placeholders before the first ComposeFlux deployment.
# The Git URL may be HTTPS because the repository is intended to be public.
GIT_REPO_URL=https://github.com/OWNER/REPOSITORY.git
GIT_BRANCH=main

# Infisical machine identity credentials. Create a Viewer identity limited to
# this project and production environment, then store the secret off-host too.
INFISICAL_CLIENT_ID=REPLACE_WITH_MACHINE_IDENTITY_CLIENT_ID
INFISICAL_CLIENT_SECRET=REPLACE_WITH_MACHINE_IDENTITY_CLIENT_SECRET
INFISICAL_ENVIRONMENT=prod
INFISICAL_PROJECT_ID=REPLACE_WITH_PROJECT_ID
INFISICAL_SECRET_PATH=/
# ComposeFlux reaches the API on the private Docker network.
INFISICAL_SITE_URL=http://infisical-api:8080
