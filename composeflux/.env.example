# Installer creates /etc/vps-bootstrap/composeflux.env with root:root ownership,
# mode 0600. This file is documentation only; never add real credentials here.
INFISICAL_DOMAIN=https://app.infisical.com
INFISICAL_PROJECT_ID=replace-with-project-id
INFISICAL_ENVIRONMENT=prod
INFISICAL_SECRET_PATH=/
INFISICAL_CLIENT_ID=replace-with-universal-auth-client-id
INFISICAL_CLIENT_SECRET=replace-with-universal-auth-client-secret
